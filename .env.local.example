# Public, and safe in the browser: the anon key only ever gets what row level
# security allows it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server only. Never prefix either of these with NEXT_PUBLIC_ — that would ship
# them to every visitor's browser.
#
# The service role key ignores row level security entirely, so it is what lets
# the API routes read a member's email address and approve a pro listing. Without
# it, /pros/review cannot work and no notification email can be sent.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend, for the emails the site sends: a new message arrived, a pro listing is
# waiting to be read, a pro's listing has gone live. Leave it unset and those
# quietly do not send, rather than breaking the thing that triggered them.
RESEND_API_KEY=your-resend-key-here
